{
  "name": "wishflow-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "pnpm --dir apps/duolingo-avatar run dev",
    "build:site": "node scripts/build-site.mjs",
    "install:apps": "node scripts/install-apps.mjs",
    "install:browser-deps": "pnpm --dir apps/ball-growth-lab exec playwright install-deps chromium",
    "test:catalog": "node scripts/project-catalog.test.mjs",
    "test:static": "pnpm --dir apps/duolingo-avatar run test:static",
    "test:worker": "pnpm --dir apps/duolingo-avatar run test:worker",
    "test:e2e": "pnpm --dir apps/duolingo-avatar run test:e2e",
    "test:ci": "pnpm --dir apps/duolingo-avatar run test:ci",
    "semantic:catalog": "pnpm --dir apps/duolingo-avatar run semantic:catalog",
    "semantic:check": "pnpm --dir apps/duolingo-avatar run semantic:check",
    "semantic:codex:tasks": "pnpm --dir apps/duolingo-avatar run semantic:codex:tasks",
    "semantic:codex:merge": "pnpm --dir apps/duolingo-avatar run semantic:codex:merge",
    "semantic:codex:compare": "pnpm --dir apps/duolingo-avatar run semantic:codex:compare",
    "semantic:codex:report": "pnpm --dir apps/duolingo-avatar run semantic:codex:report",
    "check:cloudflare-config": "pnpm --dir apps/duolingo-avatar run check:cloudflare-config",
    "deploy:cf:pages": "pnpm --dir apps/duolingo-avatar run deploy:cf:pages",
    "deploy:cf:worker": "pnpm --dir apps/duolingo-avatar run deploy:cf:worker"
  }
}
