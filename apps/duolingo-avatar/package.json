{
  "name": "@wishflow/duolingo-avatar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:app": "npm run build",
    "test:static": "./scripts/python.sh tests/test_static_site.py",
    "test:worker": "node --import tsx --test tests/worker.test.mjs",
    "test:e2e": "./scripts/python.sh tests/test_avatar_explorer.py --port 8775 --debug-port 9228",
    "semantic:catalog": "./scripts/python.sh scripts/semantic_catalog.py",
    "semantic:check": "./scripts/python.sh scripts/semantic_catalog.py --check",
    "semantic:codex:tasks": "./scripts/python.sh scripts/semantic_codex.py tasks",
    "semantic:codex:merge": "./scripts/python.sh scripts/semantic_codex.py merge",
    "semantic:codex:compare": "./scripts/python.sh scripts/semantic_codex.py compare",
    "semantic:codex:report": "./scripts/python.sh scripts/semantic_codex.py report",
    "test:ci": "npm run test:static && npm run test:worker && npm run test:e2e -- --require-browser",
    "check:cloudflare-config": "node scripts/check_cloudflare_config.mjs",
    "deploy:cf:worker": "wrangler deploy",
    "deploy:cf:pages": "wrangler pages deploy ../../_site --project-name=wishflow-tools --branch=master"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.1",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.94.0"
  }
}
