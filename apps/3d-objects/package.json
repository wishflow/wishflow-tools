{
  "name": "@wishflow/3d-objects",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "generate:scene": "node scripts/generate-scene.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:scene": "node scripts/check-scene.mjs",
    "check:web": "node scripts/check-web.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run check:web && pnpm run typecheck && vite build && pnpm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ci": "pnpm run check:assets && pnpm run test:unit && pnpm run build && pnpm run test:e2e",
    "check:release": "pnpm run generate:scene && pnpm run check:scene && pnpm run test:ci"
  },
  "dependencies": {
    "@wishflow/site-shell": "file:../../packages/site-shell",
    "three": "^0.186.1",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "3.5.43",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
